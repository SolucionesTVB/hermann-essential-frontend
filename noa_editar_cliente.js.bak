/**
 * NOA EDITAR CLIENTE - Modal para editar datos de póliza
 */

(function() {
    'use strict';

    const CAMPOS_EDITABLES = [
        { key: 'asegurado', label: 'Asegurado', type: 'text' },
        { key: 'identificacion', label: 'Identificación', type: 'text' },
        { key: 'poliza', label: '# Póliza', type: 'text' },
        { key: 'telefono', label: 'Teléfono', type: 'text' },
        { key: 'correo', label: 'Email', type: 'email' },
        { key: 'periodicidad', label: 'Periodicidad', type: 'select', opciones: ['Mensual', 'Trimestral', 'Semestral', 'Anual'] },
        { key: 'desde', label: 'Vigencia Desde', type: 'text', placeholder: 'DD/MM/YYYY' },
        { key: 'hasta', label: 'Vigencia Hasta', type: 'text', placeholder: 'DD/MM/YYYY' },
        { key: 'moneda', label: 'Moneda', type: 'select', opciones: ['CRC', 'USD'] },
        { key: 'prima', label: 'Prima', type: 'number' },
        { key: 'aseguradora', label: 'Aseguradora', type: 'text' },
        { key: 'placa', label: 'Placa/Objeto', type: 'text' }
    ];

    function crearModal() {
        const existente = document.getElementById('modal-editar-cliente');
        if (existente) existente.remove();

        const modal = document.createElement('div');
        modal.id = 'modal-editar-cliente';
        modal.style.cssText = 'display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:10000;justify-content:center;align-items:center;';

        modal.innerHTML = `
            <div style="background:#1F2937;border-radius:16px;padding:30px;max-width:600px;width:90%;max-height:80vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.5);">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
                    <h2 style="margin:0;color:#fff;font-size:24px;">✏️ Editar Cliente</h2>
                    <button onclick="cerrarModalEditar()" style="background:none;border:none;color:#fff;font-size:28px;cursor:pointer;">&times;</button>
                </div>
                <form id="form-editar-cliente">
                    <input type="hidden" id="edit-cliente-id">
                    <div id="campos-editar" style="display:grid;grid-template-columns:1fr 1fr;gap:15px;"></div>
                    <div style="margin-top:25px;display:flex;gap:15px;justify-content:flex-end;">
                        <button type="button" onclick="cerrarModalEditar()" style="background:#4B5563;color:#fff;border:none;padding:12px 25px;border-radius:8px;font-size:14px;cursor:pointer;">Cancelar</button>
                        <button type="submit" style="background:linear-gradient(135deg,#10B981,#059669);color:#fff;border:none;padding:12px 25px;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;">💾 Guardar Cambios</button>
                    </div>
                </form>
            </div>
        `;

        document.body.appendChild(modal);
        document.getElementById('form-editar-cliente').addEventListener('submit', guardarCambios);
        return modal;
    }

    function editarCliente(id) {
        const cliente = (window.datosReales || []).find(c => c.id === id);
        if (!cliente) {
            alert('Cliente no encontrado');
            return;
        }

        let modal = document.getElementById('modal-editar-cliente');
        if (!modal) modal = crearModal();

        document.getElementById('edit-cliente-id').value = id;
        const contenedor = document.getElementById('campos-editar');
        contenedor.innerHTML = '';

        CAMPOS_EDITABLES.forEach(campo => {
            const valor = cliente[campo.key] || '';
            let inputHTML = '';

            if (campo.type === 'select') {
                const opciones = campo.opciones.map(op => 
                    `<option value="${op}" ${String(valor).toLowerCase() === op.toLowerCase() ? 'selected' : ''}>${op}</option>`
                ).join('');
                inputHTML = `<select id="edit-${campo.key}" style="width:100%;background:#111827;border:1px solid #374151;border-radius:8px;color:#fff;padding:10px;font-size:14px;">
                    <option value="">-- Seleccionar --</option>${opciones}</select>`;
            } else {
                inputHTML = `<input type="${campo.type}" id="edit-${campo.key}" value="${valor}" placeholder="${campo.placeholder || ''}" 
                    style="width:100%;background:#111827;border:1px solid #374151;border-radius:8px;color:#fff;padding:10px;font-size:14px;box-sizing:border-box;">`;
            }

            contenedor.innerHTML += `
                <div style="display:flex;flex-direction:column;gap:5px;">
                    <label style="color:#9CA3AF;font-size:13px;font-weight:500;">${campo.label}</label>
                    ${inputHTML}
                </div>
            `;
        });

        modal.style.display = 'flex';
    }

    function cerrarModalEditar() {
        const modal = document.getElementById('modal-editar-cliente');
        if (modal) modal.style.display = 'none';
    }

    async function guardarCambios(e) {
        e.preventDefault();

        const id = document.getElementById('edit-cliente-id').value;
        const cliente = (window.datosReales || []).find(c => c.id === id);
        if (!cliente) {
            alert('Error: Cliente no encontrado');
            return;
        }

        const cambios = {};
        CAMPOS_EDITABLES.forEach(campo => {
            const input = document.getElementById('edit-' + campo.key);
            if (input) cambios[campo.key] = input.value;
        });

        console.log('💾 Guardando cambios:', cambios);
        Object.assign(cliente, cambios);

        if (window.actualizarClienteSupabase) {
            try {
                const resultado = await window.actualizarClienteSupabase(id, cambios);
                if (resultado && resultado.error) {
                    alert('⚠️ Error guardando: ' + resultado.error);
                    return;
                }
            } catch (err) {
                console.error('Error Supabase:', err);
                alert('⚠️ Error guardando en base de datos');
                return;
            }
        }

        localStorage.setItem('clientes_data', JSON.stringify(window.datosReales));
        cerrarModalEditar();
        
        if (window.NOA_RENDER_CARTERA && window.datosReales.length > 0) {
            window.NOA_RENDER_CARTERA({ cols: Object.keys(window.datosReales[0]), data: window.datosReales });
        }

        alert('✅ Cliente actualizado correctamente');
    }

    window.editarCliente = editarCliente;
    window.cerrarModalEditar = cerrarModalEditar;
    console.log('✅ noa_editar_cliente.js cargado');
})();
